{
  "name": "quiz-runner",
  "version": "0.2.0",
  "private": true,
  "description": "Un agent crée un QCU via MCP, un humain le passe dans une page web, l'agent relit les réponses et corrige.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "desktop:install": "node scripts/install-claude-desktop.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
